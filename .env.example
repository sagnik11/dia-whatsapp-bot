AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=azure/model-name
# Optional; leave blank to use AI_GATEWAY_MODEL for images and PDFs too.
AI_GATEWAY_MEDIA_MODEL=

# Optional persistent company memory. For self-hosting, start the Compose
# "memory" profile once, copy the generated sm_ key from its logs, then enable.
SUPERMEMORY_ENABLED=false
SUPERMEMORY_BASE_URL=http://supermemory:6767
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=autter-company
# Result count, not a model output-token limit. Every exchange is still stored whole.
SUPERMEMORY_RECALL_LIMIT=12
SUPERMEMORY_RECALL_THRESHOLD=0.35
SUPERMEMORY_TIMEOUT_MS=20000

# Local open-source whisper.cpp sidecar used by Docker Compose.
# tiny is fastest on small VPS instances; base is more accurate but slower.
WHISPER_MODEL=tiny
WHISPER_THREADS=2
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_MS=180000
# Only needed outside Compose; Compose wires this URL automatically.
WHISPER_TRANSCRIPTION_URL=

NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
# Optional: grants bounded read and append-only access to one Notion page.
NOTION_BRAIN_DUMP_PAGE_ID=
# Optional: searches and reads every page/database shared with this integration.
NOTION_KNOWLEDGE_ENABLED=false
NOTION_TITLE_PROPERTY=Task name
NOTION_STATUS_PROPERTY=Status
NOTION_DEFAULT_STATUS=Not started
NOTION_DUE_DATE_PROPERTY=Due date
NOTION_ASSIGNEE_PROPERTY=Assignee
NOTION_DEFAULT_ASSIGNEE_ID=
NOTION_ASSIGNEE_MAP_JSON={}
# Optional founder expense database. Uses NOTION_ASSIGNEE_MAP_JSON when the
# separate payer map is blank.
NOTION_SPEND_DATA_SOURCE_ID=
NOTION_SPEND_PAYER_MAP_JSON=
NOTION_PRIORITY_PROPERTY=Priority
NOTION_TASK_TYPE_PROPERTY=Task type

# Optional: enables quick lookup and bounded delegated research.
TAVILY_API_KEY=
# Maximum searches inside one delegated research run (1-5).
RESEARCH_MAX_SEARCHES=3

BOT_NAME=Captain Patch
BOT_TRIGGER=@patch
TIMEZONE=Asia/Kolkata
ALLOWED_GROUP_IDS=
AUTHORIZED_USER_IDS=
UNAUTHORIZED_REPLY=Harbour's closed — only Autter's founders get the command deck. ⚓
CONTEXT_MESSAGE_LIMIT=6
# 0 disables digests. Set 4 to send incomplete Notion tasks every four hours.
TASK_DIGEST_INTERVAL_HOURS=0
# Optional; falls back to ALLOWED_GROUP_IDS when empty.
TASK_DIGEST_GROUP_IDS=
# Optional daily AI founder brief in TIMEZONE, for example 09:00.
FOUNDER_BRIEF_TIME=
# Optional; falls back to ALLOWED_GROUP_IDS when empty.
FOUNDER_BRIEF_GROUP_IDS=

# WhatsApp attachment limit after base64 decoding (default 5 MB).
MEDIA_MAX_BYTES=5000000

# Optional Notion task/comment change notifications. Requires a public HTTPS route.
NOTION_WEBHOOK_ENABLED=false
NOTION_WEBHOOK_PORT=3000
NOTION_WEBHOOK_PATH=/notion/webhook
# Leave blank for the first webhook verification request, then copy from logs.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Optional; falls back to ALLOWED_GROUP_IDS when empty.
NOTION_NOTIFICATION_GROUP_IDS=
# false prevents Patch's own Notion writes from echoing into WhatsApp.
NOTION_NOTIFY_BOT_EVENTS=false
LIST_GROUPS_ON_START=true
DATA_DIR=.data
LOG_LEVEL=info
PUPPETEER_EXECUTABLE_PATH=
