# --- Cloudflare: model (Workers AI via AI Gateway) and task list (D1) -------
CLOUDFLARE_ACCOUNT_ID=
# Needs Account > Workers AI > Read and Account > D1 > Edit.
CLOUDFLARE_API_TOKEN=
# AI Gateway name for logs, caching, rate limits, and analytics. "default"
# is created automatically on first use.
CLOUDFLARE_AI_GATEWAY_ID=default
# Primary open-source model (tool calling + vision, 262k context, paid-only).
CLOUDFLARE_AI_MODEL=@cf/moonshotai/kimi-k2.6
# Used when the primary is rate limited or unavailable. Leave blank to disable.
CLOUDFLARE_AI_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
# none = fast WhatsApp replies; high = slower, more deliberate; blank = model default.
CLOUDFLARE_AI_REASONING_EFFORT=none
CLOUDFLARE_AI_TIMEOUT_MS=120000
# D1 database UUID that holds the task list. Tables are created on startup.
CLOUDFLARE_D1_DATABASE_ID=
# Optional separate D1-only token; defaults to CLOUDFLARE_API_TOKEN.
CLOUDFLARE_D1_API_TOKEN=
# Convert PDFs and Office documents to Markdown with Workers AI.
CLOUDFLARE_DOCUMENT_CONVERSION=true

# --- Local open-source whisper.cpp sidecar used by Docker Compose -----------
# tiny is fastest on small VPS instances; base is more accurate but slower.
WHISPER_MODEL=tiny
WHISPER_THREADS=2
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_MS=180000
# Only needed outside Compose; Compose wires this URL automatically.
WHISPER_TRANSCRIPTION_URL=

# --- Notion: spend log and Brain Dump only (no tasks) -----------------------
# Required only when one of the Notion features below is configured.
NOTION_API_KEY=
# Founder expense database (data source ID) and payer -> Notion user ID map,
# for example {"sagnik":"notion-user-id-1","tanvi":"notion-user-id-2"}.
NOTION_SPEND_DATA_SOURCE_ID=
NOTION_SPEND_PAYER_MAP_JSON=
# Brain Dump page: bounded reads and append-only notes.
NOTION_BRAIN_DUMP_PAGE_ID=
# Optional, off by default: read-only search over everything shared with the
# integration, and the live Dekhte Hai script library.
NOTION_KNOWLEDGE_ENABLED=false
NOTION_SCRIPT_SOURCE_MAP_JSON={}
NOTION_SCRIPT_SERIES_NAME=Dekhte Hai

# --- Optional web search and delegated research -----------------------------
TAVILY_API_KEY=
# Maximum searches inside one delegated research run (1-5).
RESEARCH_MAX_SEARCHES=3

# --- WhatsApp ----------------------------------------------------------------
BOT_NAME=Captain Patch
BOT_TRIGGER=@patch
TIMEZONE=Asia/Kolkata
ALLOWED_GROUP_IDS=
AUTHORIZED_USER_IDS=
UNAUTHORIZED_REPLY=Harbour's closed — only Autter's founders get the command deck. ⚓
CONTEXT_MESSAGE_LIMIT=6
# Days of group conversation kept on this server for briefs and look-backs.
# 0 stores nothing (and the daily brief must then be turned off).
CONVERSATION_RETENTION_DAYS=90
# Daily brief written from the group conversation since the last brief, in
# TIMEZONE. Skipped on quiet days. Set it empty to turn the brief off.
FOUNDER_BRIEF_TIME=09:00
# Optional; falls back to ALLOWED_GROUP_IDS when empty.
FOUNDER_BRIEF_GROUP_IDS=
# Monday review from last week's conversation and work; empty time turns it off.
WEEKLY_REVIEW_DAY=monday
WEEKLY_REVIEW_TIME=09:30
# Nightly long-term memory distilled from the conversation; empty turns it off.
MEMORY_DISTILL_TIME=23:30
# Briefs, reviews and memory can think longer than chat replies.
CLOUDFLARE_AI_BACKGROUND_REASONING_EFFORT=high

# WhatsApp attachment limit after base64 decoding (default 5 MB).
MEDIA_MAX_BYTES=5000000
LIST_GROUPS_ON_START=true
DATA_DIR=.data
LOG_LEVEL=info
PUPPETEER_EXECUTABLE_PATH=

# --- Finance (Phase 2) ---
# Subscriptions and budgets live in D1 and always work; receipts, roll-ups,
# reimbursements and subscription detection read the Notion spend log above.
# Payment methods that spend company money (comma-separated). Reimbursable
# entries paid this way are never counted as owed to a founder.
FINANCE_COMPANY_PAYMENT_METHODS=Company card
