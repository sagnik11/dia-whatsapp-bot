{
  "name": "dia-whatsapp-bot",
  "version": "0.1.0",
  "description": "A mention-triggered WhatsApp group assistant with AI and Notion task reading and creation.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "postinstall": "patch-package",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "whatsapp",
    "openai",
    "notion",
    "bot",
    "assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^5.24.0",
    "dotenv": "^17.2.3",
    "openai": "^7.4.0",
    "patch-package": "^8.0.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  }
}
